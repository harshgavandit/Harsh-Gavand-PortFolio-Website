{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node scripts/run-npm.mjs ci --include=dev --no-audit --no-fund",
  "buildCommand": "node scripts/run-npm.mjs run build",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "includeFiles": "{server,src/data}/**",
      "excludeFiles": "{.env,.env.*,tmp/**,verification/**,dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [{ "path": "/api/quota-reconcile", "schedule": "15 4 * * *" }]
}
