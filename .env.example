# Vercel Production environment. Never prefix these secrets with VITE_.
SITE_URL=https://harshgavand.dev
ALLOWED_ORIGINS=https://harshgavand.dev
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=replace-with-existing-openai-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-existing-writable-rest-token
AI_DAILY_REQUEST_LIMIT=200
AI_MONTHLY_BUDGET_USD=1.00
# Generate a random value of at least 32 characters; Vercel sends it to the cron.
CRON_SECRET=replace-with-a-long-random-secret
