# Server-only. Never use a VITE_ prefix for a secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001
# For production, set this to the exact public site origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind one trusted reverse proxy (e.g. Render).
TRUST_PROXY=0
