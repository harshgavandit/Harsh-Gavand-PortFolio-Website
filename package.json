{
  "name": "beautiful-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs",
    "test:prerender": "node --test scripts/prerender.test.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node --test scripts/portfolio.test.mjs scripts/chat.test.mjs scripts/openai.test.mjs scripts/quota.test.mjs scripts/quota-lifecycle.test.mjs scripts/npm-environment.test.mjs scripts/vercel.test.mjs scripts/admission.test.mjs scripts/work-pages.test.mjs scripts/voice.test.mjs scripts/voice-client.test.mjs",
    "format": "prettier --write src scripts/*.mjs index.html vite.config.js tsconfig.json eslint.config.js vercel.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.501.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.27.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
